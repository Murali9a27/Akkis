# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser; never put secrets in them.

# Canonical site origin (metadata, canonical URLs, sitemap).
# Defaults to https://www.akkishealthybaking.com when unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement id. Leave empty locally and on previews so test
# traffic doesn't pollute analytics; set to G-J376SF6XL2 in Vercel Production.
NEXT_PUBLIC_GA_ID=
