# Copy to .env.local for local development. Never commit real values.
# Only NEXT_PUBLIC_* variables are exposed to the browser; never put secrets in them.
# Full strategy: docs/SUPABASE-ARCHITECTURE.md §H

# ── Site ────────────────────────────────────────────────────────────────────────────────
# Origin of THIS environment (metadata, absolute links). Environment-specific — set it in
# every environment; if unset it falls back to the production domain, which is wrong outside
# Production. (Auth email links don't depend on it: they use the requesting origin.)
#   Local:              NEXT_PUBLIC_SITE_URL=http://localhost:3000
#   Vercel Preview:     NEXT_PUBLIC_SITE_URL=<stable Preview URL, e.g. https://akkis-git-next-app-<team>.vercel.app>
#   Vercel Production:  NEXT_PUBLIC_SITE_URL=https://www.akkishealthybaking.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4. Leave empty locally/previews; set G-J376SF6XL2 in Vercel Production only.
NEXT_PUBLIC_GA_ID=

# ── Business contact details (public, shown on the site; never hardcode them in code) ─────
# International format (E.164). Required on every Vercel deployment (Preview + Production).
NEXT_PUBLIC_CONTACT_PHONE=+91XXXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX
NEXT_PUBLIC_CONTACT_EMAIL=you@example.com

# ── Supabase (browser-safe values only) ───────────────────────────────────────────────────
# Local development → STAGING project. Vercel Preview → STAGING. Vercel Production → PRODUCTION.
# The app refuses to start if these point at the wrong project (lib/supabase/target-guard.ts),
# and rejects secret / service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── App email (server only; optional) ─────────────────────────────────────────────────────
# Supabase Auth emails use each Supabase project's own SMTP settings, not these.
# disabled | console | resend
EMAIL_PROVIDER=disabled
EMAIL_FROM=
# Secret. Separate keys per environment; never commit.
RESEND_API_KEY=
# Outside Vercel Production, ONLY these comma-separated addresses ever receive email.
EMAIL_ALLOWED_RECIPIENTS=

# ── Never set in this file or in Vercel ──────────────────────────────────────────────────
# Supabase secret/service-role key, database password, SUPABASE_ACCESS_TOKEN.
# The Supabase CLI reads SUPABASE_ACCESS_TOKEN / SUPABASE_DB_PASSWORD from your shell.
