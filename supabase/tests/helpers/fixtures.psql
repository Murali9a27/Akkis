-- Shared fixtures for pgTAP tests. Included with \ir from each *.test.sql file, inside that
-- file's transaction (everything is rolled back at the end). Not a test file itself.

create extension if not exists pgtap with schema extensions;

create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

-- Identity switching -----------------------------------------------------------------------
-- Usage:  select tests.claims_for(tests.admin_id()); set local role authenticated;
--         reset role;   -- back to postgres (always allowed)
create function tests.admin_id() returns uuid language sql immutable as $$ select '11111111-1111-4111-8111-111111111111'::uuid $$;
create function tests.user_id() returns uuid language sql immutable as $$ select '22222222-2222-4222-8222-222222222222'::uuid $$;

create function tests.claims_for(user_id uuid) returns void language sql as $$
  select set_config(
    'request.jwt.claims',
    json_build_object('sub', user_id, 'role', 'authenticated', 'aal', 'aal1')::text,
    true
  );
$$;
create function tests.anon_claims() returns void language sql as $$
  select set_config('request.jwt.claims', '{"role":"anon"}', true);
$$;
grant execute on all functions in schema tests to anon, authenticated;

-- Users: one admin, one ordinary authenticated user ---------------------------------------
insert into auth.users (id, instance_id, aud, role, email)
values
  (tests.admin_id(), '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', 'admin@test.local'),
  (tests.user_id(),  '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', 'user@test.local');
insert into public.admin_users (user_id) values (tests.admin_id());

