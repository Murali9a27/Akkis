-- Order helper: a valid Pune quick-delivery order for the given items and mobile -------------
create function tests.pune_order(items jsonb, mobile text) returns jsonb language sql as $$
  select public.place_order(
    'Test Customer', mobile, null, 'Flat 1, Test Building, Test Road', null, 'Pune', '411057', null,
    'pune', 'quick', null, null, null, null, items
  );
$$;
grant execute on function tests.pune_order(jsonb, text) to anon, authenticated;

-- A minimal valid custom-cake request payload (delivery 3 days ahead in IST).
create function tests.cake_request(overrides jsonb default '{}') returns jsonb language sql as $$
  select jsonb_build_object(
    'occasion', 'Birthday', 'size', 'half_kg', 'tiers', 1, 'flavour', 'Chocolate',
    'finish', 'Cream Finish', 'theme', 'Kids & Characters', 'topper', 'Akki''s Choice',
    'delivery_date', ((now() at time zone 'Asia/Kolkata')::date + 3)::text,
    'delivery_slot', 'morning', 'address', 'Flat 1, Test Building, Pune 411057',
    'customer_name', 'Test Customer', 'whatsapp', '+919800000001'
  ) || overrides;
$$;
grant execute on function tests.cake_request(jsonb) to anon, authenticated;
